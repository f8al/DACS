{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schema/detection.schema.json",
  "title": "Detection rule",
  "description": "Sigma rule or Sigma correlation plus a required detection_engineering block. Every field here is enforced in CI.",
  "type": "object",
  "required": ["title", "id", "status", "description", "author", "date", "falsepositives", "level", "tags", "detection_engineering"],
  "oneOf": [
    { "required": ["logsource", "detection"], "not": { "required": ["correlation"] } },
    { "required": ["correlation"], "not": { "anyOf": [{ "required": ["logsource"] }, { "required": ["detection"] }] } }
  ],
  "properties": {
    "title": { "type": "string", "minLength": 10, "maxLength": 120 },
    "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "status": { "enum": ["draft", "test", "stable", "deprecated", "unsupported"] },
    "description": { "type": "string", "minLength": 40 },
    "references": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "author": { "type": "string" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "modified": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "logsource": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "category": { "type": "string" },
        "product": { "type": "string" },
        "service": { "type": "string" },
        "definition": { "type": "string" }
      }
    },
    "detection": { "type": "object", "required": ["condition"] },
    "correlation": {
      "type": "object",
      "required": ["type", "rules", "timespan"],
      "properties": {
        "type": { "enum": ["event_count", "value_count", "temporal", "temporal_ordered"] },
        "rules": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "group-by": { "type": "array", "items": { "type": "string" } },
        "timespan": { "type": "string", "pattern": "^[0-9]+[smhdwMy]$" },
        "condition": { "type": "object" }
      }
    },
    "falsepositives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } },
    "level": { "enum": ["informational", "low", "medium", "high", "critical"] },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^(attack\\.|cve\\.|detection\\.|car\\.|tlp\\.)" }
    },
    "detection_engineering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle", "requirement", "validation", "operations"],
      "properties": {
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "owner", "review_interval_days", "last_reviewed"],
          "properties": {
            "stage": { "enum": ["proposed", "in_development", "in_test", "production", "deprecated"] },
            "owner": { "type": "string" },
            "review_interval_days": { "type": "integer", "minimum": 30, "maximum": 365 },
            "last_reviewed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "deprecation_reason": { "type": "string" }
          }
        },
        "requirement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "work_item", "priority_score"],
          "properties": {
            "source": { "enum": ["threat_intel", "red_team", "purple_team", "incident", "compliance", "vendor_gap", "hunt", "new_technology"] },
            "work_item": { "type": "string", "pattern": "^#[0-9]+$" },
            "priority_score": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "last_validated", "evidence"],
          "properties": {
            "method": { "enum": ["unit_only", "flightsim", "threatest", "atomic_red_team", "stratus_red_team", "manual", "none"] },
            "detonation_command": { "type": "string" },
            "scenario_file": { "type": "string" },
            "last_validated": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "evidence": { "type": "string" },
            "known_evasions": { "type": "array", "items": { "type": "string" } }
          }
        },
        "operations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ads", "runbook", "response_action", "volume_budget_per_week"],
          "properties": {
            "ads": { "type": "string", "pattern": "^docs/ads/.+\\.md$" },
            "runbook": { "type": "string", "pattern": "^docs/runbooks/.+\\.md$" },
            "response_action": { "enum": ["page", "ticket", "hunt_only", "enrich_only"] },
            "volume_budget_per_week": { "type": "integer", "minimum": 0 },
            "suppression": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
